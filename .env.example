# Copy this file to .env.local and fill in the project URL and publishable
# key from the Supabase dashboard (Connect, or Project Settings → API Keys).
# .env.local is git-ignored; never commit real values.
#
# Only the publishable key belongs here. Never put a secret or service-role
# key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
